# ==============================================================================
# AI Meeting Intelligence — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# Do NOT commit .env with real secrets to version control.

# Application API Configuration
API_PORT=3000
NODE_ENV=development

# Filesystem Job Storage (Host path)
# Shared between Node Application API and n8n Docker container
JOB_STORAGE_DIR=./data/jobs
JOB_TTL_SECONDS=3600

# n8n Orchestrator Configuration
N8N_BASE_URL=http://localhost:5678
N8N_PROCESS_WEBHOOK=http://localhost:5678/webhook/process-meeting
N8N_CLEANUP_WEBHOOK=http://localhost:5678/webhook/cleanup

# AI Provider Credentials (Server / n8n side only - NEVER expose to frontend)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration (Non-sensitive configuration only)
VITE_API_URL=http://localhost:3000
